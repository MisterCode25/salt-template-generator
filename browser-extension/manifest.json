{
  "manifest_version": 3,
  "name": "Salt BO Capture Beta",
  "description": "Captures the already-open SuperOffice ticket and VTI client from Salt BO tools.",
  "version": "0.1.0",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.salt.ch/*",
    "https://*.superoffice.com/*",
    "https://*.superoffice.ch/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Salt BO Capture Beta"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://mistercode25.github.io/salt-template-generator/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
